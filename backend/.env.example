# Shared secret for POST /api/desk/snapshot (header X-Desk-Token).
# Required in production. Make.com / the chief of staff send this.
DESK_INGEST_TOKEN=

# Phone PIN for the desk UI. Cookie lasts 30 days.
# If unset, the UI accepts DESK_INGEST_TOKEN instead (via the gate or /?token=).
DESK_PIN=

# Railway sets PORT. Local default is 3000.
PORT=3000
NODE_ENV=production

# Persist the board across deploys. Mount a Railway volume at /data.
DATA_DIR=/data
